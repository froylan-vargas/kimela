{
  "name": "qimela",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @qimela/api dev",
    "dev:web": "pnpm --filter @qimela/web dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "test": "pnpm --filter './apps/*' test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @qimela/api db:migrate",
    "db:studio": "pnpm --filter @qimela/api db:studio",
    "db:generate": "pnpm --filter @qimela/api db:generate",
    "db:seed": "pnpm --filter @qimela/api db:seed"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.13",
      "postcss": "^8.5.12",
      "uuid": "^14.0.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}
